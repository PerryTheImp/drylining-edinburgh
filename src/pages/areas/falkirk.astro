---
import Layout from '../../layouts/Layout.astro';
const siteUrl = 'https://dryliningedinburgh.co.uk';
const areaName = 'Falkirk';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "LocalBusiness",
      "name": "Drylining Edinburgh",
      "@id": "https://dryliningedinburgh.co.uk/#business",
      "areaServed": { "@type": "Place", "name": "Falkirk" },
      "serviceType": "Drylining, Partition Walls, Suspended Ceilings"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", position: 1, name: "Home", item: siteUrl + "/" },
        { "@type": "ListItem", position: 2, name: "Areas", item: siteUrl + "/areas/" },
        { "@type": "ListItem", position: 3, name: "Falkirk", item: siteUrl + "/areas/falkirk/" }
      ]
    }
  ]
};
---

<section class="hero-area" style="position: relative; min-height: 400px; display: flex; align-items: center; background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%); overflow: hidden;">
  <img src="/images/hero-main.jpg" alt="Drylining services in Falkirk and Central Scotland" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.2;" />
  <div class="container" style="position: relative; z-index: 1; max-width: 900px; padding: 4rem 1rem; text-align: center;">
    <h1 style="font-size: 2.5rem; font-weight: 800; color: var(--white); margin-bottom: 1rem;">Drylining in Falkirk</h1>
    <p style="color: rgba(255,255,255,0.85); font-size: 1.0625rem; max-width: 600px; margin: 0 auto; line-height: 1.7;">CSCS-accredited drylining contractors delivering partition walls, suspended ceilings, and plasterboard across Falkirk, Central Scotland, and the wider FK postcode area.</p>
  </div>
</section>

<div style="max-width: 900px; margin: 0 auto; padding: 0 1rem;">
  <p style="padding: 1rem 1.5rem; background: var(--accent); border-left: 4px solid var(--primary); border-radius: 4px; margin: 2rem 0; font-size: 0.9375rem; color: var(--text); line-height: 1.8;"><strong>TL;DR:</strong> Drylining Edinburgh provides drylining, partition walls, and suspended ceilings across Falkirk (FK1–FK2), Central Scotland, and the wider council area. Experienced with industrial regeneration, commercial parks, and residential developments across Falkirk's FK postcode.</p>

  <section class="section"><div class="container" style="max-width:900px;">
    <h2 style="font-size:1.5rem;font-weight:700;color:var(--secondary);margin:3rem 0 1rem;">Drylining Services in Falkirk</h2>
    <p style="color:var(--text);font-size:1.0625rem;line-height:1.8;margin-bottom:1.5rem;">Falkirk is Central Scotland's fourth-largest council area with a population of around 73,000 residents in the FK1–FK2 postcode areas. Home to the Antonine Wall, the Falkirk Wheel, and one of Scotland's most significant industrial heritage sites, the area offers a unique mix of Victorian terraces, modern residential developments, and large commercial parks. This diversity means our drylining contractors work on everything from industrial warehouse conversions to commercial fit-outs in the Grangemouth industrial zone and the Falkirk town centre regeneration area.</p>
    <p style="color:var(--text);font-size:1.0625rem;line-height:1.8;">Falkirk's ongoing regeneration projects — including the Falkirk Town Centre masterplan, the Antonine Wall heritage trail improvements, and the M9 corridor enhancements — create consistent demand for commercial drylining services. We deliver partition wall installation, suspended ceilings, and fire-rated wall systems for industrial units, office refurbishments, retail premises, and residential developments throughout the FK postcode area. All work is carried out to Scottish Building Standards Part H and Part T standards.</p>
  </div></section>

  <section class="section" style="background:var(--accent);"><div class="container" style="max-width:900px;">
    <h2 style="font-size:1.5rem;font-weight:700;color:var(--secondary);margin:2rem 0 1rem;">What We Do in Falkirk</h2>
    <p style="color:var(--text);font-size:1.0625rem;line-height:1.8;margin-bottom:1.5rem;">Our Falkirk crew handles everything from single-room domestic renovations on Main Street to large-scale industrial conversions in Grangemouth — covering partition walls, suspended ceilings, and plasterboard installation across the entire FK1–FK2 postcode region.</p>
    <ul style="list-style:none;display:flex;flex-direction:column;gap:0.875rem;margin-bottom:1.5rem;">
      <li style="display:flex;gap:0.75rem;align-items:flex-start;"><span style="color:var(--primary);font-weight:700;">•</span><span><strong>Industrial drylining</strong> — Warehouse conversions, factory partitions, and fire-rated wall systems in the Grangemouth industrial zone and Falkirk business parks</span></li>
      <li style="display:flex;gap:0.75rem;align-items:flex-start;"><span style="color:var(--primary);font-weight:700;">•</span><span><strong>New build handover drylining</strong> — Pre-completion drylining for housing developments in Borland, Polmadie, and the Falkirk town centre regeneration zones</span></li>
      <li style="display:flex;gap:0.75rem;align-items:flex-start;"><span style="color:var(--primary);font-weight:700;">•</span><span><strong>Commercial fit-outs</strong> — Office refurbs, retail units, and restaurant conversions along the town centre, Braehead Centre, and Avondale Business Park</span></li>
      <li style="display:flex;gap:0.75rem;align-items:flex-start;"><span style="color:var(--primary);font-weight:700;">•</span><span><strong>Fire-rated walls</strong> — Industrial and commercial buildings require Scottish Building Standards compliance, delivered with full documentation for Falkirk Council building standards</span></li>
      <li style="display:flex;gap:0.75rem;align-items:flex-start;"><span style="color:var(--primary);font-weight:700;">•</span><span><strong>Suspended ceilings</strong> — Office refurbs, healthcare premises, and education facilities throughout the Falkirk and Central Scotland area</span></li>
      <li style="display:flex;gap:0.75rem;align-items:flex-start;"><span style="color:var(--primary);font-weight:700;">•</span><span><strong>Acoustic partitions</strong> — Residential blocks, student accommodation, and hotel conversions near the University of Stirling's Falkirk campus</span></li>
    </ul>
  </div></section>

  <section class="section"><div class="container" style="max-width:900px;">
    <h2 style="font-size:1.5rem;font-weight:700;color:var(--secondary);margin:2rem 0 1rem;">Areas of Falkirk We Cover</h2>
    <ul style="list-style:none;display:flex;flex-direction:column;gap:0.5rem;margin-bottom:1.5rem;">
      <li style="display:flex;gap:0.5rem;align-items:center;"><span style="color:var(--primary);">•</span><span>Falkirk town centre (FK1)</span></li>
      <li style="display:flex;gap:0.5rem;align-items:center;"><span style="color:var(--primary);">•</span><span>Bonnystown and Polmadie (FK1)</span></li>
      <li style="display:flex;gap:0.5rem;align-items:center;"><span style="color:var(--primary);">•</span><span>Borland and Callendar (FK2)</span></li>
      <li style="display:flex;gap:0.5rem;align-items:center;"><span style="color:var(--primary);">•</span><span>Grangemouth (FK3)</span></li>
      <li style="display:flex;gap:0.5rem;align-items:center;"><span style="color:var(--primary);">•</span><span>Avondale Business Park (FK1)</span></li>
      <li style="display:flex;gap:0.5rem;align-items:center;"><span style="color:var(--primary);">•</span><span>Braehead and Callendar Harbour (FK1)</span></li>
      <li style="display:flex;gap:0.5rem;align-items:center;"><span style="color:var(--primary);">•</span><span>Westquarter and Stenhousemuir (FK5)</span></li>
      <li style="display:flex;gap:0.5rem;align-items:center;"><span style="color:var(--primary);">•</span><span>Airth and Denny (FK6)</span></li>
      <li style="display:flex;gap:0.5rem;align-items:center;"><span style="color:var(--primary);">•</span><span>Craigforth and Banknock (FK1)</span></li>
      <li style="display:flex;gap:0.5rem;align-items:center;"><span style="color:var(--primary);">•</span><span>Killinch and Tullibody (FK10)</span></li>
    </ul>
  </div></section>

  <section class="section" style="background:var(--accent);"><div class="container" style="max-width:900px;">
    <h2 style="font-size:1.5rem;font-weight:700;color:var(--secondary);margin:2rem 0 1rem;">Falkirk Building Standards & Planning</h2>
    <p style="color:var(--text);font-size:1.0625rem;line-height:1.8;margin-bottom:1.5rem;">Falkirk falls under <strong>Falkirk Council</strong> for building standards and planning. The area contains several conservation areas, particularly in the town centre and near the Antonine Wall heritage sites. Many properties are within designated <strong>Falkirk Conservation Areas</strong>, meaning any internal structural alterations or external drylining insulation may require planning permission. We work closely with clients, architects, and the council building standards surveyors to ensure every project — from a simple room partition in a Victorian terrace to a large industrial conversion in Grangemouth — is fully compliant with current Scottish Building Standards.</p>
  </div></section>

  <section class="section"><div class="container" style="max-width:900px;">
    <h2 style="font-size:1.5rem;font-weight:700;color:var(--secondary);margin:2rem 0 1rem;">Why Choose Us for Falkirk Projects</h2>
    <p style="color:var(--text);font-size:1.0625rem;line-height:1.8;margin-bottom:1.5rem;">As a Falkirk-based drylining team with daily operations across Central Scotland, we understand the area's unique demands. From managing access on the M9 corridor to working around the Grangemouth industrial estate's safety requirements, our crew knows the area inside out. All operatives are DBS checked, fully uniformed, and experienced in delivering quality work in Falkirk's industrial and residential environments.</p>
  </div></section>

  <section class="section" style="background:var(--accent);"><div class="container" style="max-width:900px;">
    <h2 style="font-size:1.5rem;font-weight:700;color:var(--secondary);margin:2rem 0 1rem;">Related Services</h2>
    <ul style="list-style:none;display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:0.75rem;margin-bottom:1.5rem;">
      <li><a href="/services/partition-walls/" style="color:var(--primary);text-decoration:underline;">Partition Walls</a></li>
      <li><a href="/services/suspended-ceilings/" style="color:var(--primary);text-decoration:underline;">Suspended Ceilings</a></li>
      <li><a href="/services/plasterboard-installation/" style="color:var(--primary);text-decoration:underline;">Plasterboard Installation</a></li>
      <li><a href="/services/drylining-contractors/" style="color:var(--primary);text-decoration:underline;">Drylining Contractors</a></li>
      <li><a href="/services/taping-and-jointing/" style="color:var(--primary);text-decoration:underline;">Taping &amp; Jointing</a></li>
      <li><a href="/services/metal-stud-partitioning/" style="color:var(--primary);text-decoration:underline;">Metal Stud Partitioning</a></li>
    </ul>
  </div></section>

  <section class="section"><div class="container" style="max-width:900px;">
    <h2 style="font-size:1.5rem;font-weight:700;color:var(--secondary);margin:2rem 0 1rem;">Nearby Areas</h2>
    <ul style="list-style:none;display:flex;flex-direction:column;gap:0.5rem;margin-bottom:1.5rem;">
      <li style="display:flex;gap:0.5rem;align-items:center;"><span style="color:var(--primary);">•</span><a href="/areas/edinburgh/" style="color:var(--primary);text-decoration:underline;">Edinburgh</a> — 35 minutes via M9</li>
      <li style="display:flex;gap:0.5rem;align-items:center;"><span style="color:var(--primary);">•</span><a href="/areas/livingston/" style="color:var(--primary);text-decoration:underline;">Livingston</a> — 15 minutes via A804</li>
      <li style="display:flex;gap:0.5rem;align-items:center;"><span style="color:var(--primary);">•</span><a href="/areas/falkirk/" style="color:var(--primary);text-decoration:underline;">Denny</a> — 10 minutes via A91</li>
      <li style="display:flex;gap:0.5rem;align-items:center;"><span style="color:var(--primary);">•</span><a href="/areas/falkirk/" style="color:var(--primary);text-decoration:underline;">Stirling</a> — 20 minutes via A91</li>
    </ul>
  </div></section>

  <section class="section" style="background:var(--accent);"><div class="container" style="max-width:900px;">
    <h2 style="font-size:1.5rem;font-weight:700;color:var(--secondary);margin:2rem 0 1rem;">Get a Free Falkirk Quote</h2>
    <p style="color:var(--text);font-size:1.0625rem;line-height:1.8;margin-bottom:2rem;">We offer free, no-obligation site visits and written quotes for all drylining projects across Falkirk. Call us or fill in our quick form.</p>
    <div style="display:flex;gap:1rem;flex-wrap:wrap;justify-content:center;">
      <a href="/get-quote/" class="btn btn-primary" style="font-size:1.0625rem;padding:0.875rem 2rem;">Get a Free Falkirk Quote</a>
      <a href="tel:08008203090" class="btn btn-outline" style="font-size:1.0625rem;padding:0.875rem 2rem;">FREEPHONE 0800 820 3090</a>
    </div>
  </div></section>
</div>