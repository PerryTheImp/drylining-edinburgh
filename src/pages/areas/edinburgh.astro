const areaName = 'Edinburgh';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "LocalBusiness",
      "name": "Drylining Edinburgh",
      "@id": "https://dryliningedinburgh.co.uk/#business",
      "areaServed": { "@type": "City", "name": "Edinburgh" },
      "serviceType": "Drylining, Partition Walls, Suspended Ceilings"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", position: 1, name: "Home", item: siteUrl + "/" },
        { "@type": "ListItem", position: 2, name: "Areas", item: siteUrl + "/areas/" },
        { "@type": "ListItem", position: 3, name: "Edinburgh", item: siteUrl + "/areas/edinburgh/" }
      ]
    }
  ]
};
---

<Layout title="Drylining Edinburgh | Partition Walls &amp; Ceilings Contractors" description="Professional drylining contractors in Edinburgh. Expert partition walls, suspended ceilings, and plasterboard installation for Edinburgh city centre, New Town, Old Town, Leith, and the wider EH postcode region. Free quotes." canonical="/areas/edinburgh/" schema={schema}>
  <section style="position:relative;min-height:400px;display:flex;align-items:center;background:linear-gradient(135deg,#1a1a2e 0%,#16213e 100%);overflow:hidden;"> <img src="/images/hero-main.jpg" alt="Drylining services in Edinburgh's New Town and Old Town" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0.25;"> <div class="container" style="position:relative;z-index:1;text-align:center;padding:60px 20px;"> <nav style="font-size:13px;color:rgba(255,255,255,0.70);margin-bottom:12px;"> <a href="/" style="text-decoration:none;color:rgba(255,255,255,0.70);">Home</a> / <a href="/areas/" style="text-decoration:none;color:rgba(255,255,255,0.70);">Areas</a> / <span style="color:#ffffff;">Drylining in Edinburgh</span> </nav> <h1 style="font-size:clamp(28px,4vw,44px);font-weight:800;color:#ffffff;margin-bottom:14px;line-height:1.15;">Drylining in Edinburgh</h1> <p style="font-size:17px;color:rgba(255,255,255,0.85);max-width:700px;margin:0 auto;line-height:1.6;">CSCS-accredited drylining contractors delivering partition walls, suspended ceilings, and plasterboard across Edinburgh city centre, the New Town, Old Town, Leith, and the wider EH1–EH36 postcode region.</p> </div> </section> <section class="section"><div class="container" style="max-width:900px;"> <div style="padding:24px;margin-bottom:24px;border-left:4px solid var(--primary);background:var(--white);border-radius:var(--radius);border:1px solid var(--border);"> <p style="margin:0;font-size:15px;color:var(--text);"><strong>TL;DR:</strong> Drylining Edinburgh provides drylining, partition walls, and suspended ceilings across Edinburgh (EH1–EH36), Leith, and the wider City of Edinburgh council area. Experienced with historic sandstone tenements, New Town Georgian properties, and modern regeneration projects.</p> </div> <h2 style="font-size:1.75rem;font-weight:700;color:var(--secondary);margin:2.5rem 0 1rem;">Drylining Services in Edinburgh</h2> <p style="font-size:1.0625rem;color:var(--text);line-height:1.8;margin-bottom:1.5rem;">Edinburgh is the capital of Scotland with a population of over 514,000 people in the City of Edinburgh council area. Home to the UNESCO World Heritage Old Town, the Georgian New Town, Holyrood Park, and one of the UK's most dynamic city centres, the area offers a unique mix of listed sandstone tenements, Victorian terraces, modern apartment blocks, and large commercial developments along Princes Street and the Waterfront. This diversity means our drylining contractors work on everything from listed building restorations in the Old Town to commercial fit-outs in the West End and Newhaven regeneration zone.</p> <p style="font-size:1.0625rem;color:var(--text);line-height:1.8;margin-bottom:1.5rem;">The city's major ongoing projects — including the Edinburgh Tram extension, the Newhaven regeneration, the Royal Mile pedestrianisation works, and the Scottish Parliament expansion — create consistent demand for commercial drylining services. We deliver partition wall installation, suspended ceilings, and fire-rated wall systems for office refurbishments, retail units, healthcare premises, and educational buildings throughout the EH postcode area. All work is carried out to Scottish Building Standards Part H and Part T standards.</p> <h2 style="font-size:1.75rem;font-weight:700;color:var(--secondary);margin:2.5rem 0 1rem;">What We Do in Edinburgh</h2> <p style="font-size:1.0625rem;color:var(--text);line-height:1.8;margin-bottom:1.5rem;">Our Edinburgh crew handles everything from single-room domestic renovations on the Mound to large-scale commercial fit-outs in St James Quarter — covering partition walls, suspended ceilings, and plasterboard installation across the entire EH1–EH36 postcode region.</p> <ul style="list-style:disc;padding-left:1.5rem;color:var(--text);line-height:1.8;font-size:1.0625rem;margin-bottom:1.5rem;"> <li><strong>Period property drylining</strong> — Internal wall insulation, room conversions, and partition walls in historic sandstone tenements and Georgian properties across the New Town and Stockbridge</li> <li><strong>New build handover drylining</strong> — Pre-completion drylining for housing developments in Brunstane, Craigmillar, and the Easter Road regeneration zone</li> <li><strong>Commercial fit-outs</strong> — Office refurbs, retail units, and restaurant conversions along Princes Street, St James Quarter, and the Waterfront</li> <li><strong>Fire-rated walls</strong> — Multi-storey residential and commercial buildings require Scottish Building Standards compliance, delivered with full documentation for City of Edinburgh Council building standards</li> <li><strong>Suspended ceilings</strong> — Office refurbs, healthcare premises, and education facilities throughout the Edinburgh postcode area</li> <li><strong>Acoustic partitions</strong> — Residential blocks, student accommodation, and hotel conversions near the University of Edinburgh and Heriot-Watt</li> </ul> <h2 style="font-size:1.75rem;font-weight:700;color:var(--secondary);margin:2.5rem 0 1rem;">Areas of Edinburgh We Cover</h2> <ul style="list-style:disc;padding-left:1.5rem;color:var(--text);line-height:1.8;font-size:1.0625rem;margin-bottom:1.5rem;"> <li>Edinburgh city centre (EH1) — Princes Street, St James Quarter, Royal Mile</li> <li>New Town and Calton Hill (EH3)</li> <li>Old Town and Grassmarket (EH1)</li> <li>Leith and The Shore (EH6)</li> <li>Stockbridge and Marchmont (EH3)</li> <li>West End and Bruntsfield (EH10)</li> <li>Prestwick and Murrayfield (EH12)</li> <li>Easter Road and Leith Walk (EH7)</li> <li>Corstorphine and Craigentinny (EH13)</li> <li>Brunstane and Craigmillar (EH15)</li> </ul> <h2 style="font-size:1.75rem;font-weight:700;color:var(--secondary);margin:2.5rem 0 1rem;">Edinburgh Building Standards &amp; Planning</h2> <p style="font-size:1.0625rem;color:var(--text);line-height:1.8;margin-bottom:1.5rem;">Edinburgh falls under <strong>City of Edinburgh Council</strong> for building standards and planning. The city contains over 7,000 listed buildings, particularly in the UNESCO World Heritage Old Town and New Town. Many properties are within the <strong>Edinburgh Conservation Area</strong>, meaning any internal structural alterations or external drylining insulation may require listed building consent or planning permission. We work closely with clients, architects, and the council building standards surveyors to ensure every project — from a simple room partition in a Georgian house on George Street to a large commercial fit-out in St James Quarter — is fully compliant with current Scottish Building Standards.</p> <h2 style="font-size:1.75rem;font-weight:700;color:var(--secondary);margin:2.5rem 0 1rem;">Why Choose Us for Edinburgh Projects</h2> <p style="font-size:1.0625rem;color:var(--text);line-height:1.8;margin-bottom:1.5rem;">As an Edinburgh-based drylining team with daily operations across the Scottish capital, we understand the city's unique demands. From parking permits for city centre sites to working around the Old Town's conservation restrictions and managing tight access on narrow closes and wynds, our crew knows the area inside out. All operatives are DBS checked, fully uniformed, and experienced in delivering quality work in Edinburgh's prestigious historic environment.</p> <h2 style="font-size:1.75rem;font-weight:700;color:var(--secondary);margin:2.5rem 0 1rem;">Related Services</h2> <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px;margin-bottom:1.5rem;"> <a href="/services/partition-walls/" style="text-decoration:none;padding:10px 14px;background:var(--white);border-radius:6px;font-size:14px;font-weight:600;border:1px solid var(--border);color:var(--text);">Partition Walls</a> <a href="/services/fire-rated-drylining/" style="text-decoration:none;padding:10px 14px;background:var(--white);border-radius:6px;font-size:14px;font-weight:600;border:1px solid var(--border);color:var(--text);">Fire-Rated Drylining</a> <a href="/services/acoustic-drylining/" style="text-decoration:none;padding:10px 14px;background:var(--white);border-radius:6px;font-size:14px;font-weight:600;border:1px solid var(--border);color:var(--text);">Acoustic Drylining</a> <a href="/services/refurbishment-drylining/" style="text-decoration:none;padding:10px 14px;background:var(--white);border-radius:6px;font-size:14px;font-weight:600;border:1px solid var(--border);color:var(--text);">Refurbishment Drylining</a> </div> <h2 style="font-size:1.75rem;font-weight:700;color:var(--secondary);margin:2.5rem 0 1rem;">Nearby Areas</h2> <ul style="list-style:disc;padding-left:1.5rem;color:var(--text);line-height:1.8;font-size:1.0625rem;margin-bottom:1.5rem;"> <li><a href="/areas/leith/" style="color:var(--primary);text-decoration:none;font-weight:600;">Leith</a> — 10 minutes via A1</li> <li><a href="/areas/livingston/" style="color:var(--primary);text-decoration:none;font-weight:600;">Livingston</a> — 25 minutes via M8</li> <li><a href="/areas/falkirk/" style="color:var(--primary);text-decoration:none;font-weight:600;">Falkirk</a> — 35 minutes via M9</li> <li><a href="/areas/musselburgh/" style="color:var(--primary);text-decoration:none;font-weight:600;">Musselburgh</a> — 10 minutes via A6110</li> </ul> <h2 style="font-size:1.75rem;font-weight:700;color:var(--secondary);margin:2.5rem 0 1rem;">Frequently Asked Questions</h2> <div style="margin-bottom:2rem;"> <div style="border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;margin-bottom:1rem;"> <details style="border:none;"> <summary style="width:100%;text-align:left;background:var(--white);border:none;padding:1.25rem 1.5rem;font-size:1rem;font-weight:600;color:var(--secondary);cursor:pointer;display:flex;justify-content:space-between;align-items:center;list-style:none;"> What is dry lining and how does it work? <span style="font-size:1.25rem;color:var(--primary);">+</span> </summary> <div style="padding:0 1.5rem;color:var(--text-light);line-height:1.7;font-size:0.9375rem;"> Dry lining is a method of finishing internal walls and ceilings with plasterboard rather than applying several layers of wet plaster. The boards can be fixed directly to brick or blockwork with drywall adhesive, often called the dot and dab method, or screwed to a timber or metal frame. Once the plasterboard is secure, the joints and screw heads are covered with tape and jointing compound. The surface can then be sanded, painted, wallpapered or finished with a thin plaster skim. Dry lining is commonly used in new builds, extensions, renovations and commercial properties. It provides a smooth finish quickly and can also create space for insulation, soundproofing materials, electrical cables and pipework. </div> </details> </div> <div style="border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;margin-bottom:1rem;"> <details style="border:none;"> <summary style="width:100%;text-align:left;background:var(--white);border:none;padding:1.25rem 1.5rem;font-size:1rem;font-weight:600;color:var(--secondary);cursor:pointer;display:flex;justify-content:space-between;align-items:center;list-style:none;"> Do I need planning permission for drylining in Edinburgh? <span style="font-size:1.25rem;color:var(--primary);">+</span> </summary> <div style="padding:0 1.5rem;color:var(--text-light);line-height:1.7;font-size:0.9375rem;"> Internal drylining usually falls under permitted development rights and doesn't require planning permission. However, if your property is listed (Edinburgh has over 7,000 listed buildings) or within a Conservation Area, you'll need listed building consent for any internal alterations. We advise checking with City of Edinburgh Council's planning department before starting work on period properties in the Old Town, New Town, or Conservation Areas.</div> </details> </div> <div style="border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;margin-bottom:1rem;"> <details style="border:none;"> <summary style="width:100%;text-align:left;background:var(--white);border:none;padding:1.25rem 1.5rem;font-size:1rem;font-weight:600;color:var(--secondary);cursor:pointer;display:flex;justify-content:space-between;align-items:center;list-style:none;"> What are Scottish Building Standards for drylining? <span style="font-size:1.25rem;color:var(--primary);">+</span> </summary> <div style="padding:0 1.5rem;color:var(--text-light);line-height:1.7;font-size:0.9375rem;"> Scottish Building Standards Part H covers heat and energy efficiency, Part T covers ventilation, and Part C covers structural adequacy. All our drylining work in Edinburgh complies with current Scottish Building Standards. For fire-rated walls, we follow the Fire Standard (Part B) and provide full documentation. We also ensure thermal insulation meets the latest Part H requirements, which is particularly important for Edinburgh's older properties with solid stone walls.</div> </details> </div> <div style="border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;margin-bottom:1rem;"> <details style="border:none;"> <summary style="width:100%;text-align:left;background:var(--white);border:none;padding:1.25rem 1.5rem;font-size:1rem;font-weight:600;color:var(--secondary);cursor:pointer;display:flex;justify-content:space-between;align-items:center;list-style:none;"> How long does drylining take in an Edinburgh property? <span style="font-size:1.25rem;color:var(--primary);">+</span> </summary> <div style="padding:0 1.5rem;color:var(--text-light);line-height:1.7;font-size:0.9375rem;"> A typical single-room drylining job takes 2–3 days for framing and board installation, plus 1–2 days for taping, jointing, and sanding. Larger commercial projects in Edinburgh's city centre or St James Quarter can take 1–4 weeks depending on scale. We work efficiently to minimise disruption, especially on listed building projects in the Old Town where access can be tight through closes and wynds.</div> </details> </div> <div style="border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;margin-bottom:1rem;"> <details style="border:none;"> <summary style="width:100%;text-align:left;background:var(--white);border:none;padding:1.25rem 1.5rem;font-size:1rem;font-weight:600;color:var(--secondary);cursor:pointer;display:flex;justify-content:space-between;align-items:center;list-style:none;"> Do you offer free quotes for Edinburgh projects? <span style="font-size:1.25rem;color:var(--primary);">+</span> </summary> <div style="padding:0 1.5rem;color:var(--text-light);line-height:1.7;font-size:0.9375rem;"> Yes, we offer free, no-obligation site visits and written quotes for all drylining projects across Edinburgh and the wider Lothians. We'll assess your property, discuss your requirements, and provide a detailed written quote within 48 hours. Call us on 0800 820 3090 or fill in our contact form to arrange your free site visit.</div> </details> </div> </div> <h2 style="font-size:1.75rem;font-weight:700;color:var(--secondary);margin:2.5rem 0 1rem;">Get a Free Edinburgh Quote</h2> <p style="font-size:1.0625rem;color:var(--text);line-height:1.8;margin-bottom:2rem;">We offer free, no-obligation site visits and written quotes for all drylining projects across Edinburgh. Call us or fill in our quick form.</p> <div style="margin-top:2rem;text-align:center;"> <a href="/get-quote/" class="btn btn-primary" style="font-size:1.0625rem;padding:1rem 2.5rem;">Get a Free Edinburgh Quote</a> <a href="tel:08008203090" class="btn btn-secondary" style="font-size:1.0625rem;padding:1rem 2.5rem;border:2px solid var(--primary);background:transparent;color:var(--primary);margin-left:0.5rem;">FREEPHONE 0800 820 3090</a> </div> </div></section>
</Layout>
