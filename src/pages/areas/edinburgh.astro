---
import Layout from '../../layouts/Layout.astro';
const siteUrl = 'https://dryliningedinburgh.co.uk';
const areaName = 'Edinburgh';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "LocalBusiness",
      "name": "Drylining Edinburgh",
      "@id": "https://dryliningedinburgh.co.uk/#business",
      "areaServed": { "@type": "City", "name": "Edinburgh" },
      "serviceType": "Drylining, Partition Walls, Suspended Ceilings"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", position: 1, name: "Home", item: siteUrl + "/" },
        { "@type": "ListItem", position: 2, name: "Areas", item: siteUrl + "/areas/" },
        { "@type": "ListItem", position: 3, name: "Edinburgh", item: siteUrl + "/areas/edinburgh/" }
      ]
    }
  ]
};
---

<section class="hero-area" style="position: relative; min-height: 400px; display: flex; align-items: center; background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%); overflow: hidden;">
  <img src="/images/hero-main.jpg" alt="Drylining services in Edinburgh's New Town and Old Town" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.2;" />
  <div class="container" style="position: relative; z-index: 1; max-width: 900px; padding: 4rem 1rem; text-align: center;">
    <h1 style="font-size: 2.5rem; font-weight: 800; color: var(--white); margin-bottom: 1rem;">Drylining in Edinburgh</h1>
    <p style="color: rgba(255,255,255,0.85); font-size: 1.0625rem; max-width: 600px; margin: 0 auto; line-height: 1.7;">CSCS-accredited drylining contractors delivering partition walls, suspended ceilings, and plasterboard across Edinburgh's city centre, New Town, Old Town, Leith, and the wider Lothians.</p>
  </div>
</section>

<div style="max-width: 900px; margin: 0 auto; padding: 0 1rem;">
  <p style="padding: 1rem 1.5rem; background: var(--accent); border-left: 4px solid var(--primary); border-radius: 4px; margin: 2rem 0; font-size: 0.9375rem; color: var(--text); line-height: 1.8;"><strong>TL;DR:</strong> Drylining Edinburgh provides drylining, partition walls, and suspended ceilings across Edinburgh (EH1–EH36), Leith, and the wider City of Edinburgh council area. Experienced with historic sandstone tenements, New Town Georgian properties, and modern regeneration projects across the Scottish capital.</p>

  <section class="section"><div class="container" style="max-width:900px;">
    <h2 style="font-size:1.5rem;font-weight:700;color:var(--secondary);margin:3rem 0 1rem;">Drylining Services in Edinburgh</h2>
    <p style="color:var(--text);font-size:1.0625rem;line-height:1.8;margin-bottom:1.5rem;">Edinburgh is the capital of Scotland with a population of over 514,000 people in the City of Edinburgh council area. Home to the UNESCO World Heritage Old Town, the Georgian New Town, Holyrood Park, and one of the UK's most dynamic city centres, the area offers a unique mix of listed sandstone tenements, Victorian terraces, modern apartment blocks, and large commercial developments along Princes Street and the Waterfront. This diversity means our drylining contractors work on everything from listed building restorations in the Old Town to commercial fit-outs in the West End and Newhaven regeneration zone.</p>
    <p style="color:var(--text);font-size:1.0625rem;line-height:1.8;">The city's major ongoing projects — including the Edinburgh Tram extension, the Newhaven regeneration, the Royal Mile pedestrianisation works, and the Scottish Parliament expansion — create consistent demand for commercial drylining services. We deliver partition wall installation, suspended ceilings, and fire-rated wall systems for office refurbishments, retail units, healthcare premises, and educational buildings throughout the EH postcode area. All work is carried out to Scottish Building Standards Part H and Part T standards.</p>
  </div></section>

  <section class="section" style="background:var(--accent);"><div class="container" style="max-width:900px;">
    <h2 style="font-size:1.5rem;font-weight:700;color:var(--secondary);margin:2rem 0 1rem;">What We Do in Edinburgh</h2>
    <p style="color:var(--text);font-size:1.0625rem;line-height:1.8;margin-bottom:1.5rem;">Our Edinburgh crew handles everything from single-room domestic renovations on the Mound to large-scale commercial fit-outs in St James Quarter — covering partition walls, suspended ceilings, and plasterboard installation across the entire EH1–EH36 postcode region.</p>
    <ul style="list-style:none;display:flex;flex-direction:column;gap:0.875rem;margin-bottom:1.5rem;">
      <li style="display:flex;gap:0.75rem;align-items:flex-start;"><span style="color:var(--primary);font-weight:700;">•</span><span><strong>Period property drylining</strong> — Internal wall insulation, room conversions, and partition walls in historic sandstone tenements and Georgian properties across the New Town and Stockbridge</span></li>
      <li style="display:flex;gap:0.75rem;align-items:flex-start;"><span style="color:var(--primary);font-weight:700;">•</span><span><strong>New build handover drylining</strong> — Pre-completion drylining for housing developments in Brunstane, Craigmillar, and the Easter Road regeneration zone</span></li>
      <li style="display:flex;gap:0.75rem;align-items:flex-start;"><span style="color:var(--primary);font-weight:700;">•</span><span><strong>Commercial fit-outs</strong> — Office refurbs, retail units, and restaurant conversions along Princes Street, St James Quarter, and the Waterfront</span></li>
      <li style="display:flex;gap:0.75rem;align-items:flex-start;"><span style="color:var(--primary);font-weight:700;">•</span><span><strong>Fire-rated walls</strong> — Multi-storey residential and commercial buildings require Scottish Building Standards compliance, delivered with full documentation for City of Edinburgh Council building standards</span></li>
      <li style="display:flex;gap:0.75rem;align-items:flex-start;"><span style="color:var(--primary);font-weight:700;">•</span><span><strong>Suspended ceilings</strong> — Office refurbs, healthcare premises, and education facilities throughout the Edinburgh postcode area</span></li>
      <li style="display:flex;gap:0.75rem;align-items:flex-start;"><span style="color:var(--primary);font-weight:700;">•</span><span><strong>Acoustic partitions</strong> — Residential blocks, student accommodation, and hotel conversions near the University of Edinburgh and Heriot-Watt</span></li>
    </ul>
  </div></section>

  <section class="section"><div class="container" style="max-width:900px;">
    <h2 style="font-size:1.5rem;font-weight:700;color:var(--secondary);margin:2rem 0 1rem;">Areas of Edinburgh We Cover</h2>
    <ul style="list-style:none;display:flex;flex-direction:column;gap:0.5rem;margin-bottom:1.5rem;">
      <li style="display:flex;gap:0.5rem;align-items:center;"><span style="color:var(--primary);">•</span><span>Edinburgh city centre (EH1) — Princes Street, St James Quarter, Royal Mile</span></li>
      <li style="display:flex;gap:0.5rem;align-items:center;"><span style="color:var(--primary);">•</span><span>New Town and Calton Hill (EH3)</span></li>
      <li style="display:flex;gap:0.5rem;align-items:center;"><span style="color:var(--primary);">•</span><span>Old Town and Grassmarket (EH1)</span></li>
      <li style="display:flex;gap:0.5rem;align-items:center;"><span style="color:var(--primary);">•</span><span>Leith and The Shore (EH6)</span></li>
      <li style="display:flex;gap:0.5rem;align-items:center;"><span style="color:var(--primary);">•</span><span>Stockbridge and Marchmont (EH3)</span></li>
      <li style="display:flex;gap:0.5rem;align-items:center;"><span style="color:var(--primary);">•</span><span>West End and Bruntsfield (EH10)</span></li>
      <li style="display:flex;gap:0.5rem;align-items:center;"><span style="color:var(--primary);">•</span><span>Prestwick and Murrayfield (EH12)</span></li>
      <li style="display:flex;gap:0.5rem;align-items:center;"><span style="color:var(--primary);">•</span><span>Easter Road and Leith Walk (EH7)</span></li>
      <li style="display:flex;gap:0.5rem;align-items:center;"><span style="color:var(--primary);">•</span><span>Corstorphine and Craigentinny (EH13)</span></li>
      <li style="display:flex;gap:0.5rem;align-items:center;"><span style="color:var(--primary);">•</span><span>Brunstane and Craigmillar (EH15)</span></li>
    </ul>
  </div></section>

  <section class="section" style="background:var(--accent);"><div class="container" style="max-width:900px;">
    <h2 style="font-size:1.5rem;font-weight:700;color:var(--secondary);margin:2rem 0 1rem;">Edinburgh Building Standards & Planning</h2>
    <p style="color:var(--text);font-size:1.0625rem;line-height:1.8;margin-bottom:1.5rem;">Edinburgh falls under <strong>City of Edinburgh Council</strong> for building standards and planning. The city contains over 7,000 listed buildings, particularly in the UNESCO World Heritage Old Town and New Town. Many properties are within the <strong>Edinburgh Conservation Area</strong>, meaning any internal structural alterations or external drylining insulation may require listed building consent or planning permission. We work closely with clients, architects, and the council building standards surveyors to ensure every project — from a simple room partition in a Georgian house on George Street to a large commercial fit-out in St James Quarter — is fully compliant with current Scottish Building Standards.</p>
  </div></section>

  <section class="section"><div class="container" style="max-width:900px;">
    <h2 style="font-size:1.5rem;font-weight:700;color:var(--secondary);margin:2rem 0 1rem;">Why Choose Us for Edinburgh Projects</h2>
    <p style="color:var(--text);font-size:1.0625rem;line-height:1.8;margin-bottom:1.5rem;">As a Edinburgh-based drylining team with daily operations across the Scottish capital, we understand the city's unique demands. From parking permits for city centre sites to working around the Old Town's conservation restrictions and managing tight access on narrow closes and wynds, our crew knows the area inside out. All operatives are DBS checked, fully uniformed, and experienced in delivering quality work in Edinburgh's prestigious historic environment.</p>
  </div></section>

  <section class="section" style="background:var(--accent);"><div class="container" style="max-width:900px;">
    <h2 style="font-size:1.5rem;font-weight:700;color:var(--secondary);margin:2rem 0 1rem;">Related Services</h2>
    <ul style="list-style:none;display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:0.75rem;margin-bottom:1.5rem;">
      <li><a href="/services/partition-walls/" style="color:var(--primary);text-decoration:underline;">Partition Walls</a></li>
      <li><a href="/services/suspended-ceilings/" style="color:var(--primary);text-decoration:underline;">Suspended Ceilings</a></li>
      <li><a href="/services/plasterboard-installation/" style="color:var(--primary);text-decoration:underline;">Plasterboard Installation</a></li>
      <li><a href="/services/drylining-contractors/" style="color:var(--primary);text-decoration:underline;">Drylining Contractors</a></li>
      <li><a href="/services/taping-and-jointing/" style="color:var(--primary);text-decoration:underline;">Taping &amp; Jointing</a></li>
      <li><a href="/services/metal-stud-partitioning/" style="color:var(--primary);text-decoration:underline;">Metal Stud Partitioning</a></li>
    </ul>
  </div></section>

  <section class="section"><div class="container" style="max-width:900px;">
    <h2 style="font-size:1.5rem;font-weight:700;color:var(--secondary);margin:2rem 0 1rem;">Nearby Areas</h2>
    <ul style="list-style:none;display:flex;flex-direction:column;gap:0.5rem;margin-bottom:1.5rem;">
      <li style="display:flex;gap:0.5rem;align-items:center;"><span style="color:var(--primary);">•</span><a href="/areas/leith/" style="color:var(--primary);text-decoration:underline;">Leith</a> — 10 minutes via A1</li>
      <li style="display:flex;gap:0.5rem;align-items:center;"><span style="color:var(--primary);">•</span><a href="/areas/livingston/" style="color:var(--primary);text-decoration:underline;">Livingston</a> — 25 minutes via M8</li>
      <li style="display:flex;gap:0.5rem;align-items:center;"><span style="color:var(--primary);">•</span><a href="/areas/falkirk/" style="color:var(--primary);text-decoration:underline;">Falkirk</a> — 35 minutes via M9</li>
      <li style="display:flex;gap:0.5rem;align-items:center;"><span style="color:var(--primary);">•</span><a href="/areas/musselburgh/" style="color:var(--primary);text-decoration:underline;">Musselburgh</a> — 10 minutes via A6110</li>
    </ul>
  </div></section>

  <section class="section" style="background:var(--accent);"><div class="container" style="max-width:900px;">
    <h2 style="font-size:1.5rem;font-weight:700;color:var(--secondary);margin:2rem 0 1rem;">Get a Free Edinburgh Quote</h2>
    <p style="color:var(--text);font-size:1.0625rem;line-height:1.8;margin-bottom:2rem;">We offer free, no-obligation site visits and written quotes for all drylining projects across Edinburgh. Call us or fill in our quick form.</p>
    <div style="display:flex;gap:1rem;flex-wrap:wrap;justify-content:center;">
      <a href="/get-quote/" class="btn btn-primary" style="font-size:1.0625rem;padding:0.875rem 2rem;">Get a Free Edinburgh Quote</a>
      <a href="tel:08008203090" class="btn btn-outline" style="font-size:1.0625rem;padding:0.875rem 2rem;">FREEPHONE 0800 820 3090</a>
    </div>
  </div></section>
</div>