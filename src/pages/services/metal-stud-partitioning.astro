---
import Layout from '../../layouts/Layout.astro';

const serviceName = 'Metal Stud Partitioning';
const serviceSlug = 'metal-stud-partitioning';

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {"@type":"Question","name":"What is metal stud partitioning?","acceptedAnswer":{"@type":"Answer","text":"Metal stud partitioning is a modern wall framing system using lightweight steel studs and tracks. It creates strong, straight walls that are fire-resistant, dimensionally stable, and easy to modify in the future."}},
    {"@type":"Question","name":"Is metal stud better than timber framing?","acceptedAnswer":{"@type":"Answer","text":"Metal studs offer several advantages over timber: they do not warp, rot, or shrink; they are fire-resistant; and they are lighter and easier to handle. They are the preferred choice for commercial and modern residential projects."}},
    {"@type":"Question","name":"How long does metal stud partitioning take to install?","acceptedAnswer":{"@type":"Answer","text":"A typical office partition wall takes 1-2 days. Larger commercial fit-outs in Edinburgh may take 3-7 days depending on the number of partitions and complexity of the layout."}},
    {"@type":"Question","name":"Can metal stud walls be soundproofed?","acceptedAnswer":{"@type":"Answer","text":"Yes. We install acoustic insulation within the cavity and can use double-layer plasterboard with acoustic boards to achieve excellent sound reduction for offices, meeting rooms, and bedrooms."}},
    {"@type":"Question","name":"Are metal stud partitions fire-rated?","acceptedAnswer":{"@type":"Answer","text":"Yes. When combined with fire-rated plasterboard, metal stud partitions can achieve fire ratings from 30 minutes up to 120 minutes, meeting Scottish Building Standards requirements."}},
    {"@type":"Question","name":"Can metal stud walls be moved or reconfigured later?","acceptedAnswer":{"@type":"Answer","text":"Yes. One of the key benefits of metal stud partitioning is that walls can be dismantled and reconfigured more easily than blockwork or traditional stud walls, making them ideal for flexible office layouts."}},
    {"@type":"Question","name":"What areas do you cover for metal stud partitioning in Edinburgh?","acceptedAnswer":{"@type":"Answer","text":"We provide metal stud partitioning across Edinburgh city centre, Leith, Newington, Stockbridge, Bruntsfield, Morningside, Portobello, and all surrounding areas including Livingston, Falkirk, Dalkeith, and Musselburgh."}}
  ],
};

const serviceJsonLd = {
