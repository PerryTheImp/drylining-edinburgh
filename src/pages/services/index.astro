---
import Layout from '../../layouts/Layout.astro';
import FlipCard from '../../components/FlipCard.astro';

const services = [
  { title: 'Drylining Contractors', description: 'Expert drylining installation for residential and commercial properties across Edinburgh. We create smooth, paint-ready wall finishes quickly and cleanly.', link: '/services/drylining-contractors/' },
  { title: 'Partition Walls', description: 'Build durable, cost-effective partition walls to divide open-plan offices, retail units, and homes. Sound-rated and fire-rated options available.', link: '/services/partition-walls/' },
  { title: 'Metal Stud Partitioning', description: 'Lightweight, strong metal stud partitions perfect for commercial fit-outs. Faster to install and easier to modify than traditional timber framing.', link: '/services/metal-stud-partitioning/' },
  { title: 'Suspended Ceilings', description: 'Install clean, modern suspended ceilings that hide services, improve acoustics, and enhance lighting. Ideal for offices, retail, and healthcare.', link: '/services/suspended-ceilings/' },
  { title: 'Plasterboard Installation', description: 'Precision plasterboard fitting for walls and ceilings. Seamless joints, professional finishing, and minimal disruption to your project timeline.', link: '/services/plasterboard-installation/' },
  { title: 'Taping & Jointing', description: 'Smooth, crack-resistant finishes with expert taping and jointing. No need for full plastering — faster, cleaner, and ready for decoration.', link: '/services/taping-and-jointing/' },
  { title: 'Commercial Drylining', description: 'Large-scale drylining for offices, retail spaces, warehouses, and public buildings across Edinburgh and the Lothians. We work to tight deadlines and specifications.', link: '/services/commercial-drylining/' },
  { title: 'Office Drylining', description: 'Create modern, flexible office interiors with drylined partitions, feature walls, and ceiling systems. Minimal downtime for your business.', link: '/services/office-drylining/' },
  { title: 'Fire-Rated Drylining', description: 'Certified fire-rated drylining providing 30 to 120 minutes of fire protection. Scottish Building Standards compliant with full documentation.', link: '/services/fire-rated-drylining/' },
  { title: 'Acoustic Drylining', description: 'Professional acoustic drylining and soundproofing for homes, offices, and studios. Reduces noise transmission by 45-52 dB.', link: '/services/acoustic-drylining/' },
  { title: 'Insulated Drylining', description: 'Improve thermal performance and reduce heating costs with insulated drylining using Celotex, Kingspan, and Rockwool materials.', link: '/services/insulated-drylining/' },
  { title: 'Refurbishment Drylining', description: 'Complete drylining solutions for home renovations, office refurbishments, and property conversions across Edinburgh.', link: '/services/refurbishment-drylining/' },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "serviceType": "Drylining Services",
      "provider": { "@type": "LocalBusiness", "name": "Drylining Edinburgh", "@id": "https://dryliningedinburgh.co.uk/#business" },
      "areaServed": { "@type": "City", "name": "Edinburgh" }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://dryliningedinburgh.co.uk/" },
        { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://dryliningedinburgh.co.uk/services/" }
      ]
    }
  ]
};
---

<Layout title="Drylining Services Edinburgh | Partitions, Ceilings & More" description="Full range of drylining services in Edinburgh: partition walls, suspended ceilings, metal stud framing, plasterboard, taping & jointing. Free quotes." canonical="/services/" schema={schema}>
  <section style="background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%); padding: 5rem 0; text-align: center;">
    <div class="container">
      <h1 style="font-size: 2.75rem; font-weight: 800; color: var(--white); margin-bottom: 1rem;">Our Drylining Services</h1>
      <p style="font-size: 1.125rem; color: rgba(255,255,255,0.85); max-width: 700px; margin: 0 auto;">From single-room renovations to full commercial fit-outs, we provide every drylining service you need across Edinburgh and the Lothians.</p>
    </div>
  </section>

  <section class="section" style="background: var(--accent);">
    <div class="container">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem;">
        {services.map(s => (
          <FlipCard title={s.title} description={s.description} link={s.link} icon={'<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>'} />
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container" style="text-align: center;">
      <h2 style="font-size: 2rem; font-weight: 800; color: var(--secondary); margin-bottom: 1rem;">Need a Custom Drylining Solution?</h2>
      <p style="color: var(--text-light); max-width: 600px; margin: 0 auto 2rem; font-size: 1.0625rem;">Every project is different. Tell us what you need and we will tailor our drylining services to fit your budget, timeline, and specifications.</p>
      <a href="/get-quote/" class="btn btn-primary" style="font-size: 1.0625rem; padding: 1rem 2.5rem;">Get Your Free Quote</a>
    </div>
  </section>
</Layout>
