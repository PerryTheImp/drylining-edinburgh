---
import Layout from '../../layouts/Layout.astro';

const serviceName = 'Commercial Drylining';
const serviceSlug = 'commercial-drylining';

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {"@type":"Question","name":"What is commercial drylining?","acceptedAnswer":{"@type":"Answer","text":"Commercial drylining is the installation of plasterboard systems in offices, retail units, warehouses, and public buildings. It includes partition walls, ceiling systems, and feature walls delivered to tight deadlines and professional standards."}},
    {"@type":"Question","name":"How long does a commercial drylining project take?","acceptedAnswer":{"@type":"Answer","text":"Small office fit-outs take 3-5 days. Large retail or warehouse projects may take 2-4 weeks. We provide detailed timelines during your quote and work to agreed schedules."}},
    {"@type":"Question","name":"Can you work out of hours to minimise business disruption?","acceptedAnswer":{"@type":"Answer","text":"Yes. We regularly work evenings, weekends, and overnight to ensure minimal disruption to your business operations."}},
    {"@type":"Question","name":"Do you provide fire-rated commercial drylining?","acceptedAnswer":{"@type":"Answer","text":"Yes. We install fire-rated plasterboard and cavity barriers to meet Scottish Building Standards Section 2 (Fire) for offices, schools, and healthcare facilities."}},
    {"@type":"Question","name":"Are your operatives CSCS accredited?","acceptedAnswer":{"@type":"Answer","text":"Yes. All our commercial drylining operatives hold valid CSCS cards and are fully insured for work on active construction sites."}},
    {"@type":"Question","name":"What types of commercial buildings do you work on?","acceptedAnswer":{"@type":"Answer","text":"We work on offices, retail chains, warehouses, schools, healthcare facilities, industrial units, and public buildings across Edinburgh and the Lothians."}},
    {"@type":"Question","name":"What areas do you cover for commercial drylining?","acceptedAnswer":{"@type":"Answer","text":"We provide commercial drylining services across Edinburgh, Leith, Livingston, Dalkeith, Musselburgh, Falkirk, and all surrounding Lothians and Central Scotland areas."}}
  ],
};

const serviceJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Commercial Drylining Edinburgh",
  additionalType: "https://www.wikidata.org/entity/Q213825",
  about: { "@type": "Thing", name: "Drywall", sameAs: ['https://www.wikidata.org/entity/Q213825', 'https://en.wikipedia.org/wiki/Drywall'] },
  sameAs: "https://en.wikipedia.org/wiki/Drywall",
  provider: {
    "@type": "Organization",
    name: "Drylining Edinburgh",
    "@id": "https://dryliningedinburgh.co.uk/#business",
    knowsAbout: ['https://en.wikipedia.org/wiki/Drywall', 'https://en.wikipedia.org/wiki/Plaster', 'https://en.wikipedia.org/wiki/Partition_wall', 'https://en.wikipedia.org/wiki/Building_regulations_in_the_United_Kingdom', 'https://en.wikipedia.org/wiki/Construction_worker', 'https://en.wikipedia.org/wiki/General_contractor', 'https://en.wikipedia.org/wiki/Cold-formed_steel', 'https://en.wikipedia.org/wiki/Dropped_ceiling'],
  },
  areaServed: {
    "@type": "Place",
    name: "Edinburgh and surrounding areas",
    sameAs: [
      "https://en.wikipedia.org/wiki/Edinburgh",
      "https://www.wikidata.org/entity/Q23436"
    ],
    geo: { "@type": "GeoCoordinates", "latitude": 55.9533, "longitude": -3.1883 }
  },
};
