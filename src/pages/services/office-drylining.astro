---
import Layout from '../../layouts/Layout.astro';

const serviceName = 'Office Drylining';
const serviceSlug = 'office-drylining';

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {"@type":"Question","name":"What is office drylining?","acceptedAnswer":{"@type":"Answer","text":"Office drylining is the installation of plasterboard partition walls, feature walls, and ceiling systems to create modern, flexible office interiors. It is faster and cleaner than traditional construction methods."}},
    {"@type":"Question","name":"Can you convert open-plan offices to cellular layouts?","acceptedAnswer":{"@type":"Answer","text":"Yes. We specialise in converting open-plan spaces into private offices, meeting rooms, and breakout areas using drylined partition walls with acoustic and fire-rated options."}},
    {"@type":"Question","name":"How long does an office drylining project take?","acceptedAnswer":{"@type":"Answer","text":"A small office refurbishment takes 2-4 days. Larger fit-outs with multiple partitions and ceiling systems may take 1-2 weeks. We provide detailed timelines during your quote."}},
    {"@type":"Question","name":"Can you work outside business hours?","acceptedAnswer":{"@type":"Answer","text":"Yes. We regularly work evenings, weekends, and overnight to minimise disruption to your business. Phased working is also available for larger projects."}},
    {"@type":"Question","name":"Do you install acoustic partitions for offices?","acceptedAnswer":{"@type":"Answer","text":"Yes. We install acoustic insulation within partition cavities and use sound-rated plasterboard to create quiet meeting rooms and private offices in open-plan environments."}},
    {"@type":"Question","name":"Can drylining include glass partition integration?","acceptedAnswer":{"@type":"Answer","text":"Yes. We can integrate glass partitions with drylining systems to create modern offices with meeting rooms, private offices, and reception areas that maintain an open, professional feel."}},
    {"@type":"Question","name":"What areas do you cover for office drylining?","acceptedAnswer":{"@type":"Answer","text":"We provide office drylining services across Edinburgh, Leith, Livingston, Dalkeith, Musselburgh, Falkirk, and all surrounding Lothians and Central Scotland areas."}}
  ],
};

const serviceJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Office Drylining Edinburgh",
  additionalType: "https://www.wikidata.org/entity/Q213825",
  about: { "@type": "Thing", name: "Drywall", sameAs: ['https://www.wikidata.org/entity/Q213825', 'https://en.wikipedia.org/wiki/Drywall'] },
  sameAs: "https://en.wikipedia.org/wiki/Drywall",
  provider: {
    "@type": "Organization",
    name: "Drylining Edinburgh",
    "@id": "https://dryliningedinburgh.co.uk/#business",
    knowsAbout: ['https://en.wikipedia.org/wiki/Drywall', 'https://en.wikipedia.org/wiki/Plaster', 'https://en.wikipedia.org/wiki/Partition_wall', 'https://en.wikipedia.org/wiki/Building_regulations_in_the_United_Kingdom', 'https://en.wikipedia.org/wiki/Construction_worker', 'https://en.wikipedia.org/wiki/General_contractor', 'https://en.wikipedia.org/wiki/Cold-formed_steel', 'https://en.wikipedia.org/wiki/Dropped_ceiling'],
  },
  areaServed: {
    "@type": "Place",
    name: "Edinburgh and surrounding areas",
    sameAs: [
      "https://en.wikipedia.org/wiki/Edinburgh",
      "https://www.wikidata.org/entity/Q23436"
    ],
    geo: { "@type": "GeoCoordinates", "latitude": 55.9533, "longitude": -3.1883 }
  },
};
