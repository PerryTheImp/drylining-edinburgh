---
import Layout from '../../layouts/Layout.astro';

const serviceName = 'Acoustic Drylining';
const serviceSlug = 'acoustic-drylining';

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {"@type":"Question","name":"What is acoustic drylining?","acceptedAnswer":{"@type":"Answer","text":"Acoustic drylining is a specialist construction system designed to reduce sound transmission between rooms and spaces. It combines acoustic plasterboard, sound-absorbing insulation within the frame, and careful sealing of all gaps and joints to achieve significant noise reduction."}},
    {"@type":"Question","name":"How much noise reduction can acoustic drylining achieve?","acceptedAnswer":{"@type":"Answer","text":"A well-designed acoustic drylining system can achieve sound reductions of 45-52 dB (Rw), depending on the construction. This means voices, music, and everyday noise are significantly reduced, making rooms much quieter and more private."}},
    {"@type":"Question","name":"Where is acoustic drylining most useful?","acceptedAnswer":{"@type":"Answer","text":"Acoustic drylining is ideal for bedrooms, home offices, music studios, meeting rooms, flats sharing walls, hotel rooms, student accommodation, schools, and any space where noise reduction is important. In Edinburgh's dense New Town and Old Town tenements, acoustic drylining is particularly valuable for sound insulation between flats."}},
    {"@type":"Question","name":"What materials are used in acoustic drylining?","acceptedAnswer":{"@type":"Answer","text":"We use acoustic plasterboard such as Gyproc Soundbloc, combined with acoustic mineral wool insulation within the cavity, resilient channels where required, and carefully sealed joints and edges. Double-layer board systems provide even higher performance."}},
    {"@type":"Question","name":"Can acoustic drylining be installed in existing rooms?","acceptedAnswer":{"@type":"Answer","text":"Yes. We can install acoustic drylining over existing walls in existing Edinburgh properties, including Victorian tenements and Georgian townhouses. The system typically adds 50-100 mm to the wall thickness depending on the construction, and the finished surface is smooth and ready for decoration."}},
    {"@type":"Question","name":"Do acoustic drylining systems comply with Scottish Building Standards?","acceptedAnswer":{"@type":"Answer","text":"Yes. All our acoustic drylining installations comply with Scottish Building Standards Section 4 (Sound) and meet or exceed the required Rw performance values for residential, commercial, and student accommodation projects across Scotland."}},
    {"@type":"Question","name":"What areas do you cover for acoustic drylining?","acceptedAnswer":{"@type":"Answer","text":"We provide acoustic drylining services across Edinburgh, Leith, Livingston, Dalkeith, Musselburgh, Falkirk, and all surrounding Lothians and Central Scotland areas."}}
  ],
};

const serviceJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Acoustic Drylining Edinburgh",
  additionalType: "https://www.wikidata.org/entity/Q213825",
  about: { "@type": "Thing", name: "Soundproofing", sameAs: ['https://www.wikidata.org/entity/Q739531', 'https://en.wikipedia.org/wiki/Soundproofing'] },
  provider: {
    "@type": "Organization",
    name: "Drylining Edinburgh",
    "@id": "https://dryliningedinburgh.co.uk/#business"
  },
  areaServed: {
    "@type": "Place",
    name: "Edinburgh and surrounding areas",
    sameAs: [
      "https://en.wikipedia.org/wiki/Edinburgh",
      "https://www.wikidata.org/entity/Q23436"
    ],
    geo: { "@type": "GeoCoordinates", "latitude": 55.9533, "longitude": -3.1883 }
  },
};
