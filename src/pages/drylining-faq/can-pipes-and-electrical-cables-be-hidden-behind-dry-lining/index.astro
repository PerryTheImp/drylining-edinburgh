---
import Layout from '../../../layouts/Layout.astro';

const question = "Can pipes and electrical cables be hidden behind dry lining?";
const answer = "Pipes and electrical cables can be hidden behind dry lining, helping create a clean and uncluttered finish. A timber or metal frame provides a useful cavity where plumbing, wiring and data cables can be routed before the plasterboard is installed. Dot and dab dry lining also leaves a small gap, but the available space is more limited. Services must be fitted safely and in line with electrical and building regulations. Cables may require conduit, grommets or protective plates where they pass through studs. Access panels should be included for valves, joints and other components that may need future maintenance. It is sensible to photograph the locations of pipes and cables before closing the wall. This record can help prevent accidental damage when drilling later.";
const canonical = '/drylining-faq/can-pipes-and-electrical-cables-be-hidden-behind-dry-lining/';
const description = "Pipes and electrical cables can be hidden behind dry lining, helping create a clean and uncluttered finish. A timber or metal frame provides a useful cavity...";

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: question,
          acceptedAnswer: {
            '@type': 'Answer',
            text: answer,
          },
        },
      ],
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://dryliningedinburgh.co.uk/' },
        { '@type': 'ListItem', position: 2, name: 'PAA', item: 'https://dryliningedinburgh.co.uk/drylining-faq/' },
        { '@type': 'ListItem', position: 3, name: "Can pipes and electrical cables be hidden behind dry lining?", item: 'https://dryliningedinburgh.co.uk/drylining-faq/can-pipes-and-electrical-cables-be-hidden-behind-dry-lining/' },
      ],
    },
  ],
};
---

<Layout
  title="Can pipes and electrical cables be hidden behind dry lining? | Drylining Edinburgh"
  description={description}
  canonical={canonical}
  schema={schema}
>
  <main class="container" style="padding: 34px 0 70px;">
    <article class="card" style="padding: 28px; max-width: 860px;">
      <header style="margin-bottom: 22px;">
        <p style="margin: 0 0 10px; color: var(--primary); font-weight: 700; letter-spacing: 0.02em; text-transform: uppercase; font-size: 13px;">
          People Also Ask
        </p>
        <h1 style="margin: 0; font-size: clamp(26px, 4vw, 36px); line-height: 1.15;">{question}</h1>
      </header>

      <section style="padding: 18px 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); margin-bottom: 22px;">
        <p style="margin: 0; font-size: 17px; line-height: 1.8; color: var(--text); white-space: pre-wrap;">{answer}</p>
      </section>

      <div style="display: flex; gap: 12px; flex-wrap: wrap;">
        <a href="/drylining-faq/" class="btn btn-outline">Back to FAQ Hub</a>
        <a href="/faq/" class="btn btn-outline">View FAQ</a>
        <a href="/get-quote/" class="btn btn-primary">Get a Quote</a>
      </div>
    </article>
  </main>
</Layout>
