---
import Layout from '../../../layouts/Layout.astro';

const question = "Can ceilings be dry lined?";
const answer = "Ceilings can be dry lined with plasterboard to create a smooth and practical finish. Boards may be fixed directly to ceiling joists, attached to timber battens or installed on a suspended metal framework. Dry lining can conceal electrical wiring, plumbing, ventilation ducts and insulation above the ceiling. Specialist boards are available for areas requiring improved fire resistance, sound reduction or moisture protection. The plasterboard thickness, fixings and spacing of the support structure must be suitable for the weight of the ceiling. Lighting positions, access panels and ventilation openings should also be planned before installation. Because plasterboard sheets are large and heavy, ceiling work normally requires more than one person or specialist lifting equipment. The finished surface can be jointed, skimmed and decorated.";
const canonical = '/drylining-faq/can-ceilings-be-dry-lined/';
const description = "Ceilings can be dry lined with plasterboard to create a smooth and practical finish. Boards may be fixed directly to ceiling joists, attached to timber batte...";

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: question,
          acceptedAnswer: {
            '@type': 'Answer',
            text: answer,
          },
        },
      ],
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://dryliningedinburgh.co.uk/' },
        { '@type': 'ListItem', position: 2, name: 'PAA', item: 'https://dryliningedinburgh.co.uk/drylining-faq/' },
        { '@type': 'ListItem', position: 3, name: "Can ceilings be dry lined?", item: 'https://dryliningedinburgh.co.uk/drylining-faq/can-ceilings-be-dry-lined/' },
      ],
    },
  ],
};
---

<Layout
  title="Can ceilings be dry lined? | Drylining Edinburgh"
  description={description}
  canonical={canonical}
  schema={schema}
>
  <main class="container" style="padding: 34px 0 70px;">
    <article class="card" style="padding: 28px; max-width: 860px;">
      <header style="margin-bottom: 22px;">
        <p style="margin: 0 0 10px; color: var(--primary); font-weight: 700; letter-spacing: 0.02em; text-transform: uppercase; font-size: 13px;">
          People Also Ask
        </p>
        <h1 style="margin: 0; font-size: clamp(26px, 4vw, 36px); line-height: 1.15;">{question}</h1>
      </header>

      <section style="padding: 18px 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); margin-bottom: 22px;">
        <p style="margin: 0; font-size: 17px; line-height: 1.8; color: var(--text); white-space: pre-wrap;">{answer}</p>
      </section>

      <div style="display: flex; gap: 12px; flex-wrap: wrap;">
        <a href="/drylining-faq/" class="btn btn-outline">Back to FAQ Hub</a>
        <a href="/faq/" class="btn btn-outline">View FAQ</a>
        <a href="/get-quote/" class="btn btn-primary">Get a Quote</a>
      </div>
    </article>
  </main>
</Layout>
